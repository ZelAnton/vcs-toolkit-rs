{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcs-toolkit-rs.dev/schemas/agent-interface-recording-v1.json",
  "title": "Agent interface evaluation recording v1",
  "type": "object",
  "required": ["schema_version", "corpus_version", "source", "skill_metadata", "cases", "metrics", "interface_metrics", "transport_parity"],
  "properties": {
    "schema_version": {"const": "agent-interface.recording.v1"},
    "corpus_version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "skill_metadata": {
      "type": "object",
      "required": ["name", "contract_version", "path", "metric_priority", "unavailable_live_metrics"],
      "properties": {
        "name": {"const": "vcs-agent"},
        "contract_version": {"const": "vcs-agent-skill/v1"},
        "path": {"const": "../../skills/vcs-agent/SKILL.md"},
        "metric_priority": {
          "const": ["false_activation_rate", "preferred_interface_selection_rate", "raw_cli_bypass_rate"]
        },
        "unavailable_live_metrics": {"type": "null"}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "outcome_status", "selected_interface", "fallback_reason", "preferred_interface_selected", "false_activation", "raw_cli_bypass", "calls", "unrelated_changes_preserved", "revision"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "outcome_status": {"type": "string", "minLength": 1},
          "selected_interface": {"enum": ["vcs-agent", "mcp", "raw-cli", "none"]},
          "fallback_reason": {"type": ["string", "null"]},
          "preferred_interface_selected": {"type": "boolean"},
          "false_activation": {"type": "boolean"},
          "raw_cli_bypass": {"type": "boolean"},
          "calls": {
            "type": "object",
            "required": ["preferred_interface", "fallback_interface", "raw_cli", "total"],
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "unrelated_changes_preserved": {"type": "boolean"},
          "revision": {
            "type": "object",
            "required": ["before", "after", "published", "exact_revision_verified", "terminal_ci"],
            "properties": {
              "before": {"type": ["string", "null"]},
              "after": {"type": ["string", "null"]},
              "published": {"type": ["string", "null"]},
              "exact_revision_verified": {"type": "boolean"},
              "terminal_ci": {
                "type": "object",
                "required": ["verified", "revision", "conclusion"],
                "properties": {
                  "verified": {"type": "boolean"},
                  "revision": {"type": ["string", "null"]},
                  "conclusion": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {"type": "object"},
    "interface_metrics": {
      "type": "object",
      "required": ["cli+skill", "mcp"],
      "properties": {
        "cli+skill": {"$ref": "#/$defs/interfaceMeasurement"},
        "mcp": {"$ref": "#/$defs/interfaceMeasurement"}
      },
      "additionalProperties": false
    },
    "transport_parity": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["operation", "cli+skill", "mcp"],
        "properties": {
          "operation": {"enum": ["publish", "ci_status", "ci_wait"]},
          "cli+skill": {"type": "object"},
          "mcp": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "baseline": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "interfaceMeasurement": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["availability", "case_ids", "precision", "recall", "bypass_rate", "invalid_call_rate", "invalid_call_evidence", "outcome_correctness"],
          "properties": {
            "availability": {"const": "measured"},
            "case_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "precision": {"$ref": "#/$defs/ratio"},
            "recall": {"$ref": "#/$defs/ratio"},
            "bypass_rate": {"$ref": "#/$defs/ratio"},
            "invalid_call_rate": {"$ref": "#/$defs/ratio"},
            "invalid_call_evidence": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "outcome_correctness": {"$ref": "#/$defs/ratio"}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
